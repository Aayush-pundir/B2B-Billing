# Copy this file to .env and fill in real values. All values have safe defaults for local/dev use.

DATABASE_URL=sqlite:///./data/billing.db
JWT_SECRET=change-me-in-production
BOOTSTRAP_ADMIN_EMAIL=admin@example.local

ORG_NAME=Your Company Pvt Ltd
ORG_GST=
ORG_STATE_CODE=09
INVOICE_PREFIX=INV-
DEFAULT_GST_RATE=18.0

UPLOAD_DIR=./data/uploads

# Optional OAuth (SSO). Leave blank to use dev-login only.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Zoho Books integration. Leave blank to run push in simulation mode.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_API_BASE=https://www.zohoapis.in/books/v3

# Read-only connection to the platform database that holds raw usage (loading, UPI, users).
# Billing pulls monthly usage from here. Use a read-only DB user. Example:
# USAGE_DATABASE_URL=postgresql://billing_ro:password@db-host:5432/platform
USAGE_DATABASE_URL=
